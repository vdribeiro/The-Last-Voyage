import kotlin.Boolean;

CREATE TABLE IF NOT EXISTS Achievement (
    id TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL,
    preconditions TEXT NOT NULL,
    done INTEGER AS Boolean NOT NULL DEFAULT 0
);

isAchievementEmpty:
SELECT Achievement.id FROM Achievement LIMIT 1;

truncateAchievement:
DELETE FROM Achievement;

upsertAchievement:
INSERT OR REPLACE INTO Achievement VALUES ?;

getAchievements:
SELECT
    Achievement.id,
    Achievement.description,
    Achievement.preconditions,
    Achievement.done
FROM Achievement;

getAchievementsByDone:
SELECT
    Achievement.id,
    Achievement.description,
    Achievement.preconditions,
    Achievement.done
FROM Achievement
WHERE Achievement.done = :done;