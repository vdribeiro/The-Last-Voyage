CREATE TABLE IF NOT EXISTS StellarHostType (
    id TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL,
    type TEXT NOT NULL
);

isStellarHostTypeEmpty:
SELECT StellarHostType.id FROM StellarHostType LIMIT 1;

truncateStellarHostType:
DELETE FROM StellarHostType;

upsertStellarHostType:
INSERT OR REPLACE INTO StellarHostType VALUES ?;

getStellarHostTypes:
SELECT
    StellarHostType.id,
    StellarHostType.description,
    StellarHostType.type
FROM StellarHostType;
