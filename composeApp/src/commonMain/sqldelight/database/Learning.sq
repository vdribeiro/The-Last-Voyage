import com.hybris.tlv.usecase.learning.model.LearningType;

CREATE TABLE IF NOT EXISTS Learning (
    id TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL,
    image TEXT,
    type TEXT AS LearningType NOT NULL
);

isLearningEmpty:
SELECT Learning.id FROM Learning LIMIT 1;

truncateLearning:
DELETE FROM Learning;

upsertLearning:
INSERT OR REPLACE INTO Learning VALUES ?;

getLearnings:
SELECT
    Learning.id,
    Learning.description,
    Learning.image,
    Learning.type
FROM Learning;
