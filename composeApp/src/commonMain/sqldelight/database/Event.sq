CREATE TABLE IF NOT EXISTS Event (
    id TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL,
    parentId TEXT,
    outcome TEXT
);

isEventEmpty:
SELECT Event.id FROM Event LIMIT 1;

truncateEvent:
DELETE FROM Event;

upsertEvent:
INSERT OR REPLACE INTO Event VALUES ?;

getRandomEvent:
SELECT
    Event.id,
    Event.description,
    Event.parentId,
    Event.outcome
FROM Event
WHERE Event.id = (
    SELECT Event.id
    FROM Event
    WHERE Event.parentId IS NULL AND Event.id NOT IN :ids
    ORDER BY RANDOM() LIMIT 1
);

getEvents:
WITH RECURSIVE EventTree AS (
    SELECT
        RootEvent.id,
        RootEvent.description,
        RootEvent.parentId,
        RootEvent.outcome,
        RootEvent.id AS sortPath
    FROM Event RootEvent
    WHERE parentId IS NULL
    UNION ALL
    SELECT
        Event.id,
        Event.description,
        Event.parentId,
        Event.outcome,
        Tree.sortPath || '/' || Event.id
    FROM Event
    INNER JOIN EventTree Tree ON Event.parentId = Tree.id
)
SELECT
    EventTree.id,
    EventTree.description,
    EventTree.parentId,
    EventTree.outcome
FROM EventTree
ORDER BY sortPath;

getChildEvents:
SELECT
    Event.id,
    Event.description,
    Event.parentId,
    Event.outcome
FROM Event
WHERE Event.parentId = :parentId;
