CREATE TABLE IF NOT EXISTS PlanetType (
    id TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL,
    type TEXT NOT NULL
);

isPlanetTypeEmpty:
SELECT PlanetType.id FROM PlanetType LIMIT 1;

truncatePlanetType:
DELETE FROM PlanetType;

upsertPlanetType:
INSERT OR REPLACE INTO PlanetType VALUES ?;

getPlanetTypes:
SELECT
    PlanetType.id,
    PlanetType.description,
    PlanetType.type
FROM PlanetType;
