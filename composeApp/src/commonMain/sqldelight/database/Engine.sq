import kotlin.Int;

CREATE TABLE IF NOT EXISTS Engine (
    id TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL,
    velocity REAL NOT NULL,
    fuelConsumption REAL NOT NULL,
    cost INTEGER AS Int NOT NULL
);

isEngineEmpty:
SELECT Engine.id FROM Engine LIMIT 1;

truncateEngine:
DELETE FROM Engine;

upsertEngine:
INSERT OR REPLACE INTO Engine VALUES ?;

getEngines:
SELECT
    Engine.id,
    Engine.description,
    Engine.velocity,
    Engine.fuelConsumption,
    Engine.cost
FROM Engine;
